generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  password         String
  name             String
  role             String     @default("VIEWER")
  canEditAsPartner Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  personId         String?    @unique
  permissions      String?
  auditLogs        AuditLog[]
  person           Person?    @relation(fields: [personId], references: [id])

  @@index([email])
}

model Person {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String?
  phone                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  cashBuckets              CashBucket[]
  dealParticipants         DealParticipant[]
  transactions             Transaction[]
  personLedgerTransactions PersonLedgerTransaction[]
  user                     User?

  @@index([email])
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         String
  description  String?
  currency     String        @default("SAR")
  isActive     Boolean       @default(true)
  metadata     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  investments  Investment[]
  transactions Transaction[]
  valuations   Valuation[]

  @@index([type])
}

model Investment {
  id                  String                       @id @default(cuid())
  accountId           String
  name                String
  category            String?
  principalAmount     Float
  currentValue        Float                        @default(0)
  realizedProfit      Float                        @default(0)
  unrealizedProfit    Float                        @default(0)
  startDate           DateTime
  maturityDate        DateTime?
  interestRate        Float?
  notes               String?
  metadata            String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  fees                Float                        @default(0)
  totalReceived       Float                        @default(0)
  receivableAmount    Float                        @default(0)
  isIjarah            Boolean                      @default(false)
  reopenedAt          DateTime?
  cashBucketMovements CashBucketMovement[]
  dealParticipants    DealParticipant[]
  account             Account                      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bucketAllocations   InvestmentBucketAllocation[]
  transactions        Transaction[]

  @@index([accountId])
  @@index([category])
}

model CashBucket {
  id                String                       @id @default(cuid())
  label             String?
  currency          String                       @default("SAR")
  haulStartDate     DateTime
  lastZakatPaidDate DateTime?
  balance           Float                        @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  excludeFromZakat  Boolean                      @default(false)
  personId          String?
  metadata          String?
  person            Person?                      @relation(fields: [personId], references: [id])
  movements         CashBucketMovement[]
  debt              Debt?
  allocations       InvestmentBucketAllocation[]

  @@index([currency])
  @@index([haulStartDate])
  @@index([personId])
}

model CashBucketMovement {
  id           String      @id @default(cuid())
  cashBucketId String
  investmentId String?
  amount       Float
  type         String
  date         DateTime
  notes        String?
  createdAt    DateTime    @default(now())
  cashBucket   CashBucket  @relation(fields: [cashBucketId], references: [id], onDelete: Cascade)
  investment   Investment? @relation(fields: [investmentId], references: [id])

  @@index([cashBucketId])
  @@index([investmentId])
  @@index([date])
}

model InvestmentBucketAllocation {
  id                 String     @id @default(cuid())
  investmentId       String
  cashBucketId       String
  principalAllocated Float
  principalRemaining Float
  haulStartDate      DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  cashBucket         CashBucket @relation(fields: [cashBucketId], references: [id], onDelete: Cascade)
  investment         Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([investmentId, cashBucketId])
  @@index([investmentId])
  @@index([cashBucketId])
  @@index([haulStartDate])
}

model DealParticipant {
  id              String     @id @default(cuid())
  investmentId    String
  personId        String
  investedAmount  Float
  currentValue    Float      @default(0)
  receivable      Float      @default(0)
  profit          Float      @default(0)
  sharePercentage Float?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  acquiredAt      DateTime?
  commissionFees  Float      @default(0)
  investment      Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  person          Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([investmentId, personId])
  @@index([investmentId])
  @@index([personId])
}

model Transaction {
  id           String      @id @default(cuid())
  accountId    String
  investmentId String?
  personId     String?
  type         String
  amount       Float
  date         DateTime
  description  String?
  metadata     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  investment   Investment? @relation(fields: [investmentId], references: [id])
  person       Person?     @relation(fields: [personId], references: [id])

  @@index([accountId])
  @@index([investmentId])
  @@index([personId])
  @@index([date])
}

model Valuation {
  id         String   @id @default(cuid())
  accountId  String
  date       DateTime
  navPerUnit Float
  totalValue Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
}

model RecoveryAssumption {
  id           String   @id @default(cuid())
  status       String   @unique
  recoveryRate Float
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  category      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model Debt {
  id           String        @id @default(cuid())
  lenderName   String
  amount       Float
  borrowedAt   DateTime
  notes        String?
  isArchived   Boolean       @default(false)
  cashBucketId String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cashBucket   CashBucket?   @relation(fields: [cashBucketId], references: [id])
  payments     DebtPayment[]

  @@index([borrowedAt])
  @@index([lenderName])
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  amount    Float
  paidAt    DateTime
  notes     String?
  createdAt DateTime @default(now())
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([paidAt])
}

model Snapshot {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  label      String    // e.g. "Before: Close Ridwan KIA 2015"
  trigger    String    // action that triggered it
  data       String    // full JSON of affected DB state
  restoredAt DateTime?
  userId     String?   // who triggered the action

  @@index([createdAt])
  @@index([trigger])
}

model PersonLedgerTransaction {
  id        String   @id @default(cuid())
  personId  String
  date      DateTime
  type      String   // 'GIVEN' | 'RECEIVED'
  amount    Float
  currency  String   @default("SAR")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([date])
  @@index([type])
}
