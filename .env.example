# Database Configuration
# For PostgreSQL (Railway, production, or local Docker):
DATABASE_URL="postgresql://user:password@localhost:5432/investments_dashboard?schema=public"

# For SQLite (local development only - requires changing schema.prisma provider):
# DATABASE_URL="file:./dev.db"

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Cookie Configuration (optional)
COOKIE_SECURE="false"  # Set to "true" in production with HTTPS
COOKIE_SAME_SITE="lax"  # Options: lax, strict, none

# Node Environment (automatically set by Railway/Vercel)
NODE_ENV="development"

# Port (automatically set by Railway/Vercel)
PORT="3000"
